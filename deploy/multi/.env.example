# Settings every sensor in this directory shares (copy to .env).

# The release every sensor runs: change it with ./sensors.sh upgrade vX.Y.Z,
# which verifies the image signature and fetches the matching seccomp profile.
SENSOR_VERSION=v0.41.0
# Written by sensors.sh after it verified the image signature on this digest
# (do not edit): the sensors run image:tag@sha256:digest.
# SENSOR_IMAGE_DIGEST=sha256:...
# SENSOR_IMAGE_DIGEST_REF=...

# A mirror of the image (air-gapped hosts); default ghcr.io/openctemio/sensor.
# SENSOR_IMAGE=registry.example.com/openctemio/sensor
# A profile image for every sensor: -passive, -standard (the default image) or -full.
# SENSOR_VARIANT=-full

# Ceilings for each sensor (override one sensor in its compose.yaml block).
SENSOR_MEM_LIMIT=4g
SENSOR_CPUS=2
SENSOR_PIDS_LIMIT=2048
SENSOR_TMP_SIZE=1g

# Another project name lets a second directory run its own set on this host.
# COMPOSE_PROJECT_NAME=openctem-sensors
