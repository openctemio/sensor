# syntax=docker/dockerfile:1.7
# =============================================================================
# OpenCTEM Sensor - Opengrep (SAST)
# =============================================================================
# Lightweight image with Sensor + opengrep only. opengrep runs local rules
# (the managed rules pack, SENSOR_CONTENT_SEMGREP_RULES_PATH, or the
# platform's custom rules); it never fetches rules and the sensor runs it
# without network.
#
# The opengrep release binary is pinned by version and SHA-256 per
# architecture, and its keyless signature is verified with cosign against
# the opengrep release workflow's identity before it is installed.
#
# Build:
#   docker build -f Dockerfile.opengrep -t openctemio/sensor:opengrep .
#
# Usage:
#   docker run --rm -v $(pwd):/scan -v /path/to/rules:/rules:ro \
#       -e SENSOR_CONTENT_SEMGREP_RULES_PATH=/rules \
#       openctemio/sensor:opengrep -tool opengrep -target /scan -push
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: Build Go binary
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS builder

# hadolint ignore=DL3018
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src
COPY . /src

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /out/openctemio-sensor \
    .

# -----------------------------------------------------------------------------
# Stage: cosign, to verify the opengrep release signature
# -----------------------------------------------------------------------------
FROM ghcr.io/sigstore/cosign/cosign:v3.1.3@sha256:9e5c2f2edc34351160407ca3416c61855bdf9403c3c5936e0f0be7fc261611b8 AS cosign

# -----------------------------------------------------------------------------
# Stage: Download and verify opengrep
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS tool

ARG TARGETARCH
# The manylinux (glibc) build. SHA-256 per architecture pinned from the
# release assets; bump the three together. The signature is checked against
# the release workflow of exactly this version.
ARG OPENGREP_VERSION=1.31.0
ARG OPENGREP_SHA256_AMD64=dbbe3c2058dbe600c449a8ba22ea79a1643a6660658400090d0323a8d0d31147
ARG OPENGREP_SHA256_ARM64=2b713a29a00237f85408b83002fc111db5b94c7fa8d263f0a93184a960655d9d

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cosign /ko-app/cosign /usr/local/bin/cosign

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN set -eux; \
    case "${TARGETARCH}" in \
    amd64) OG_ARCH="x86"; OG_SHA256="${OPENGREP_SHA256_AMD64}" ;; \
    arm64) OG_ARCH="aarch64"; OG_SHA256="${OPENGREP_SHA256_ARM64}" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    OG="opengrep_manylinux_${OG_ARCH}"; \
    BASE="https://github.com/opengrep/opengrep/releases/download/v${OPENGREP_VERSION}"; \
    curl -fsSL -o "${OG}" "${BASE}/${OG}"; \
    curl -fsSL -o "${OG}.cert" "${BASE}/${OG}.cert"; \
    curl -fsSL -o "${OG}.sig" "${BASE}/${OG}.sig"; \
    echo "${OG_SHA256}  ${OG}" | sha256sum -c -; \
    cosign verify-blob --cert "${OG}.cert" --signature "${OG}.sig" \
        --certificate-identity "https://github.com/opengrep/opengrep/.github/workflows/rolling-release.yml@refs/heads/release-v${OPENGREP_VERSION}" \
        --certificate-oidc-issuer https://token.actions.githubusercontent.com \
        "${OG}"; \
    install -m 0755 "${OG}" /usr/local/bin/opengrep; \
    rm -f "${OG}" "${OG}.cert" "${OG}.sig"; \
    # The binary unpacks its runtime into $XDG_CACHE_HOME/opengrep on first
    # run. Unpack it here, so the image runs it read-only.
    # It unpacks owner-only (0700): make it readable, not writable, by the
    # runtime user.
    XDG_CACHE_HOME=/opt/opengrep/cache HOME=/tmp opengrep --version | grep -qx "${OPENGREP_VERSION}"; \
    chmod -R a+rX,go-w /opt/opengrep/cache

# -----------------------------------------------------------------------------
# Final: Sensor + opengrep
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

LABEL org.opencontainers.image.title="OpenCTEM Sensor - Opengrep"
LABEL org.opencontainers.image.description="Security scanning sensor with opengrep SAST (local rules only)"
LABEL org.opencontainers.image.source="https://github.com/openctemio/sensor"

# git: opengrep lists the files of a repository with it.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=tool /usr/local/bin/opengrep /usr/local/bin/
COPY --from=tool /opt/opengrep/cache /opt/opengrep/cache

# Copy sensor binary
COPY --from=builder /out/openctemio-sensor /usr/local/bin/openctemio-sensor
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Non-root. uid/gid 1001 is the GitHub-hosted runner's user, which owns the
# checked-out workspace mounted at /github/workspace, so git's ownership
# check passes and reports can be written there. git trusts exactly that
# path (system config), not every directory ('*'). Elsewhere, run the
# container as the workspace owner (docker run --user "$(id -u):$(id -g)",
# GitLab: image:docker:user) or trust the checkout for the job, e.g.
# GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$CI_PROJECT_DIR".
RUN groupadd -g 1001 openctem && useradd -u 1001 -g openctem -d /home/openctem -m openctem \
    && git config --system --add safe.directory /github/workspace \
    && mkdir -p /github/workspace && chown openctem:openctem /github/workspace

ENV HOME=/home/openctem
# The runtime unpacked at build time, read-only.
ENV XDG_CACHE_HOME=/opt/opengrep/cache

ENV CI=true
USER openctem
WORKDIR /github/workspace
ENTRYPOINT ["/usr/local/bin/openctemio-sensor"]
CMD ["-tool", "opengrep", "--help"]
