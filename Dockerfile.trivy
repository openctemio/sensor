# syntax=docker/dockerfile:1.7
# =============================================================================
# OpenCTEM Sensor - Trivy (SCA/IaC/Container)
# =============================================================================
# Lightweight image with Sensor + Trivy only (~100MB without DB, ~500MB with DB)
#
# Build:
#   # Without pre-loaded DB (downloads on first run)
#   docker build -f Dockerfile.trivy -t openctemio/sensor:trivy .
#
#   # With pre-loaded DB (faster CI, larger image)
#   docker build -f Dockerfile.trivy --target trivy-ci -t openctemio/sensor:trivy-ci .
#
# Usage:
#   docker run --rm -v $(pwd):/scan openctemio/sensor:trivy \
#       -tool trivy -target /scan -push
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: Build Go binary
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder

# hadolint ignore=DL3018
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src
COPY . /src

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /out/openctemio-sensor \
    .

# -----------------------------------------------------------------------------
# Stage: Download Trivy
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS tool

ARG TARGETARCH
ARG TRIVY_VERSION=0.76.0
# The archive SHA-256 per architecture (from the release's
# trivy_<v>_checksums.txt); bump all three together, here and in Dockerfile.
ARG TRIVY_SHA256_AMD64=e24b1c51293c1b15e4ba8d45bbc7891ba053f90278ec2698f3562c993e145fe7
ARG TRIVY_SHA256_ARM64=aab21e677a7b7071fc79f1711480840754c18a1b9d9cefa7ccd06af63a0e8f4c

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN set -eux; \
    case "${TARGETARCH}" in \
    amd64) TRIVY_ARCH="64bit"; TRIVY_SHA256="${TRIVY_SHA256_AMD64}" ;; \
    arm64) TRIVY_ARCH="ARM64"; TRIVY_SHA256="${TRIVY_SHA256_ARM64}" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    # Verify the archive against its pinned SHA-256 before extracting (same
    # supply-chain check as the main Dockerfile): a tampered or replaced
    # release asset fails sha256sum -c and aborts the build.
    TRIVY_ARCHIVE="trivy_${TRIVY_VERSION}_Linux-${TRIVY_ARCH}.tar.gz"; \
    curl -fsSL -o "${TRIVY_ARCHIVE}" \
        "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/${TRIVY_ARCHIVE}"; \
    echo "${TRIVY_SHA256}  ${TRIVY_ARCHIVE}" | sha256sum -c -; \
    tar -xzf "${TRIVY_ARCHIVE}" -C /usr/local/bin trivy; \
    chmod +x /usr/local/bin/trivy; \
    rm -f "${TRIVY_ARCHIVE}"

# -----------------------------------------------------------------------------
# Stage: Trivy with pre-downloaded DB
# -----------------------------------------------------------------------------
FROM tool AS tool-with-db

ENV TRIVY_CACHE_DIR=/root/.cache/trivy
RUN trivy image --download-db-only --no-progress

# -----------------------------------------------------------------------------
# Runtime filesystem additions (the image has no shell to make them): the
# scan user uid/gid 1001 (the GitHub-hosted runner's user, which owns a
# checked-out workspace mounted at /github/workspace), its home and the
# workspace directory.
# -----------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3 AS runtime-base

FROM builder AS runtime-fs
COPY --from=runtime-base /etc/passwd /etc/group /out/etc/
RUN echo 'openctem:x:1001:1001:openctem:/home/openctem:/sbin/nologin' >> /out/etc/passwd \
    && echo 'openctem:x:1001:' >> /out/etc/group \
    && mkdir -p /out/home/openctem/.config /out/github/workspace

# -----------------------------------------------------------------------------
# Target: trivy (without pre-loaded DB)
# -----------------------------------------------------------------------------
# Distroless static (CA certificates, time zones; no shell, git or package
# manager): the sensor and the tool are static Go binaries. Run the container
# as the workspace owner when it is not uid 1001
# (docker run --user "$(id -u):$(id -g)").
FROM runtime-base AS trivy

LABEL org.opencontainers.image.title="OpenCTEM Sensor - Trivy"
LABEL org.opencontainers.image.description="Security scanning sensor with Trivy SCA/IaC/Container"
LABEL org.opencontainers.image.source="https://github.com/openctemio/sensor"

COPY --from=runtime-fs /out/etc/passwd /out/etc/group /etc/
COPY --from=runtime-fs --chown=1001:1001 /out/home/openctem /home/openctem
COPY --from=runtime-fs --chown=1001:1001 /out/github/workspace /github/workspace
COPY --from=tool /usr/local/bin/trivy /usr/local/bin/
COPY --from=builder /out/openctemio-sensor /usr/local/bin/openctemio-sensor

ENV HOME=/home/openctem

ENV TRIVY_NO_PROGRESS=true
ENV CI=true
USER 1001:1001
WORKDIR /github/workspace
ENTRYPOINT ["/usr/local/bin/openctemio-sensor"]
CMD ["-tool", "trivy", "--help"]

# -----------------------------------------------------------------------------
# Target: trivy-ci (with pre-loaded DB for faster CI)
# -----------------------------------------------------------------------------
# Distroless static (CA certificates, time zones; no shell, git or package
# manager): the sensor and the tool are static Go binaries. Run the container
# as the workspace owner when it is not uid 1001
# (docker run --user "$(id -u):$(id -g)").
FROM runtime-base AS trivy-ci

LABEL org.opencontainers.image.title="OpenCTEM Sensor - Trivy CI"
LABEL org.opencontainers.image.description="Security scanning sensor with Trivy + preloaded vulnerability DB"
LABEL org.opencontainers.image.source="https://github.com/openctemio/sensor"

COPY --from=runtime-fs /out/etc/passwd /out/etc/group /etc/
COPY --from=runtime-fs --chown=1001:1001 /out/home/openctem /home/openctem
COPY --from=runtime-fs --chown=1001:1001 /out/github/workspace /github/workspace
COPY --from=tool-with-db /usr/local/bin/trivy /usr/local/bin/
COPY --from=builder /out/openctemio-sensor /usr/local/bin/openctemio-sensor

ENV HOME=/home/openctem
# The preloaded DB, owned by the scan user (created above, so its HOME is
# its own) and not chowned in a second layer.
COPY --from=tool-with-db --chown=1001:1001 /root/.cache/trivy /home/openctem/.cache/trivy

ENV TRIVY_CACHE_DIR=/home/openctem/.cache/trivy
ENV TRIVY_NO_PROGRESS=true
ENV CI=true
USER 1001:1001
WORKDIR /github/workspace
ENTRYPOINT ["/usr/local/bin/openctemio-sensor"]
CMD ["-tool", "trivy", "--help"]
