# syntax=docker/dockerfile:1.7
# =============================================================================
# OpenCTEM Sensor - Nuclei (DAST)
# =============================================================================
# Sensor + Nuclei binary + a pre-baked nuclei-templates set so validation works
# out-of-the-box. Bundling the templates adds their on-disk size (a few hundred
# MB extracted) to the ~100MB base — a deliberate trade so a fresh `validate:nuclei`
# returns a real verdict instead of `inconclusive` while it waits on a network
# clone that its 30s template-installed check can't finish.
#
# Build:
#   docker build -f Dockerfile.nuclei -t openctemio/sensor:nuclei .
#
# Usage:
#   docker run --rm openctemio/sensor:nuclei \
#       -tool nuclei -target https://example.com -push
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: Build Go binary
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder

# hadolint ignore=DL3018
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src
COPY . /src

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /out/openctemio-sensor \
    .

# -----------------------------------------------------------------------------
# Stage: Download Nuclei
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS tool

ARG TARGETARCH
ARG NUCLEI_VERSION=3.11.1
# The archive SHA-256 per architecture (from the release's
# nuclei_<v>_checksums.txt); bump all three together, here and in Dockerfile.
ARG NUCLEI_SHA256_AMD64=ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6
ARG NUCLEI_SHA256_ARM64=8044e3d9768ba0a744b2872c1a87e813006f013da97ca9f50f7661a4203bec07

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN set -eux; \
    case "${TARGETARCH}" in \
    amd64) NUCLEI_ARCH="amd64"; NUCLEI_SHA256="${NUCLEI_SHA256_AMD64}" ;; \
    arm64) NUCLEI_ARCH="arm64"; NUCLEI_SHA256="${NUCLEI_SHA256_ARM64}" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    # Verify the archive against its pinned SHA-256 before extracting (same
    # supply-chain check as the main Dockerfile).
    NUCLEI_ARCHIVE="nuclei_${NUCLEI_VERSION}_linux_${NUCLEI_ARCH}.zip"; \
    curl -fsSL -o "${NUCLEI_ARCHIVE}" \
        "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/${NUCLEI_ARCHIVE}"; \
    echo "${NUCLEI_SHA256}  ${NUCLEI_ARCHIVE}" | sha256sum -c -; \
    unzip -o "${NUCLEI_ARCHIVE}" nuclei -d /usr/local/bin; \
    rm -f "${NUCLEI_ARCHIVE}"; \
    chmod +x /usr/local/bin/nuclei

# A baked template set so the published image can validate on first use.
# The sensor's re-verify (nuclei.ValidateSingleTemplate) runs a template
# lookup — `nuclei -tl -id <sig> -disable-update-check`, bounded to 30s — before
# it will run a template. With -disable-update-check nuclei never auto-fetches,
# so without a baked template set that lookup finds nothing and validate:nuclei
# returns `inconclusive` instead of a real verdict.
#
# The release is pinned with the SHA-256 of its archive (the release's
# nuclei-templates-<v>_checksums.txt lists it; keep it equal to the main
# Dockerfile's). scripts/nuclei-templates-bake.sh verifies it, extracts it to
# $HOME/nuclei-templates, writes nuclei's configuration for it
# ($HOME/.config/nuclei: templates directory and release, the release's
# .nuclei-ignore) and the release record the sensor reports, and fails the
# build for any template that fails `nuclei -validate` and is not in
# docker/nuclei-templates-allowlist.txt, or a scan run that logs an error.
# The final image runs as the non-root user openctem (HOME /home/openctem), and
# nuclei records the template directory's absolute path in its config, so the
# set is baked under that same HOME here. Templates are arch-independent and
# this stage runs natively per arch in CI (no QEMU).
ARG NUCLEI_TEMPLATES_VERSION=10.4.9
ARG NUCLEI_TEMPLATES_SHA256=d7cd989935f9a84943cba8a193f567db37626dbf4e526ff57ba5b1f24badd5d6
COPY scripts/nuclei-templates-bake.sh /tmp/nuclei-templates-bake.sh
COPY docker/nuclei-templates-allowlist.txt /tmp/nuclei-templates-allowlist.txt
ENV HOME=/home/openctem
RUN bash /tmp/nuclei-templates-bake.sh "${NUCLEI_TEMPLATES_VERSION}" "${NUCLEI_TEMPLATES_SHA256}" /tmp/nuclei-templates-allowlist.txt

# -----------------------------------------------------------------------------
# Final: Sensor + Nuclei
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

LABEL org.opencontainers.image.title="OpenCTEM Sensor - Nuclei"
LABEL org.opencontainers.image.description="Security scanning sensor with Nuclei DAST"
LABEL org.opencontainers.image.source="https://github.com/openctemio/sensor"

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy nuclei from tool stage
COPY --from=tool /usr/local/bin/nuclei /usr/local/bin/


# Copy sensor binary
COPY --from=builder /out/openctemio-sensor /usr/local/bin/openctemio-sensor
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Non-root. uid/gid 1001 is the GitHub-hosted runner's user, which owns the
# checked-out workspace mounted at /github/workspace, so git's ownership
# check passes and reports can be written there. git trusts exactly that
# path (system config), not every directory ('*'). Elsewhere, run the
# container as the workspace owner (docker run --user "$(id -u):$(id -g)",
# GitLab: image:docker:user) or trust the checkout for the job, e.g.
# GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$CI_PROJECT_DIR".
RUN groupadd -g 1001 openctem && useradd -u 1001 -g openctem -d /home/openctem -m openctem \
    && git config --system --add safe.directory /github/workspace \
    && mkdir -p /github/workspace /home/openctem/.config \
    && chown openctem:openctem /github/workspace /home/openctem/.config

ENV HOME=/home/openctem
# Bake in the nuclei-templates set of the tool stage so validate:nuclei has
# a template set at first run. HOME must match where they were installed
# (/home/openctem/nuclei-templates) so nuclei's config resolves the directory
# at runtime; the sensor inherits this HOME when it invokes nuclei. The
# templates are root-owned and read-only to the sensor; nuclei's
# configuration directory is the sensor's.
COPY --from=tool /home/openctem/nuclei-templates /home/openctem/nuclei-templates
COPY --from=tool --chown=1001:1001 /home/openctem/.config/nuclei /home/openctem/.config/nuclei

ENV CI=true
USER openctem
WORKDIR /github/workspace
ENTRYPOINT ["/usr/local/bin/openctemio-sensor"]
CMD ["-tool", "nuclei", "--help"]
